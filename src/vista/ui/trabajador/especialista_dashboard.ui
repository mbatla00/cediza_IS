  <property name="styleSheet">
   <string notr="true">/* ================================================
   FONDO GENERAL DE LA APLICACIÓN
   ================================================ */
QMainWindow {
    background-color: #f8f9fa; /* Gris claro de fondo de Bootstrap */
}

/* ================================================
   CABECERA (TÍTULO Y SUBTÍTULO)
   ================================================ */
QLabel#label {
    color: #212529;
    font-size: 26px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}

QLabel#lbl_subtitulo {
    color: #6c757d;
    font-size: 14px;
}

/* BOTÓN VOLVER (¡Ahora Azul Bootstrap btn-primary!) */
QPushButton#btn_volver {
    background-color: #0d6efd;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#btn_volver:hover {
    background-color: #0b5ed7; /* Azul más oscuro al pasar el ratón */
}

QPushButton#btn_volver:pressed {
    background-color: #0a58ca; /* Al hacer clic */
}

/* ================================================
   TARJETAS CONTENEDORAS (QGroupBox)
   ================================================ */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    margin-top: 24px;
    font-weight: bold;
    font-size: 14px;
    padding-top: 15px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 6px 12px;
    left: 15px;
    top: -5px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    color: #ffffff; /* Texto blanco en la barra de la tarjeta */
}

/* Colores de cabecera idénticos a los &quot;card-header&quot; del HTML */
QGroupBox#gb_crear_sesion::title { 
    background-color: #0d6efd; /* bg-primary (Azul) */
}
QGroupBox#gb_proximas::title { 
    background-color: #198754; /* bg-success (Verde) */
}
QGroupBox#gb_pasadas::title { 
    background-color: #6c757d; /* bg-secondary (Gris) */
}

/* ================================================
   ELEMENTOS INTERNOS DEL FORMULARIO
   ================================================ */
QLabel {
    color: #212529;
    font-size: 13px;
    font-weight: 600;
}
QComboBox, QDateEdit, QTimeEdit, QTextEdit {
    border: 1px solid #ced4da;
    border-radius: 5px;
    padding: 6px;
    background-color: #ffffff;
    color: #212529;
}
QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QTextEdit:focus {
    border: 1px solid #86b7fe;
}

/* BOTÓN CREAR SESIÓN (btn-primary) */
QPushButton#btn_crear_sesion {
    background-color: #0d6efd;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_crear_sesion:hover {
    background-color: #0b5ed7;
}

/* ================================================
   TABLAS DE DATOS REVERSIVAS (QTableWidget)
   ================================================ */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    gridline-color: #f1f3f9;
}
QHeaderView::section {
    background-color: #f8f9fa; /* table-light de Bootstrap */
    color: #212529;
    padding: 10px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-bottom: 2px solid #dee2e6;
}
QTableWidget::item {
    padding: 8px;
    color: #212529;
}
QTableWidget::item:selected {
    background-color: #e8f0fe;
    color: #1a73e8;
}</string>
