  <property name="styleSheet">
   <string notr="true">/* --- FONDO DE LA VENTANA --- */
QMainWindow {
    background-color: #f8f9fa; /* Gris muy claro, simula el fondo web */
}

/* --- EL CONTENEDOR (La Tarjeta Blanca) --- */
QFrame, QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
}

/* Evitamos que los elementos internos hereden el borde del QFrame */
QLabel, QLineEdit, QDateEdit, QPushButton {
    border: none;
}

/* --- LA CABECERA AZUL --- */
/* Cambiado de turquesa al azul primario de Bootstrap */
QLabel#label {
    background-color: #0d6efd; /* Azul como el botón de guardar */
    color: white;
    font-size: 18px;
    font-weight: bold;
    padding: 12px 15px;
    /* Redondeamos solo la parte de arriba para que encaje en la tarjeta */
    border-top-left-radius: 8px; 
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

/* --- ETIQUETAS DE TEXTO (Labels) --- */
QLabel {
    color: #212529;
    font-weight: bold;
    font-size: 13px;
}

/* El texto pequeño de &quot;El nombre de usuario no se puede modificar&quot; */
QLabel#label_10 {
    color: #6c757d;
    font-weight: normal;
    font-size: 11px;
    margin-top: 2px;
}

/* --- CAMPOS DE TEXTO Y FECHA --- */
QLineEdit, QDateEdit {
    border: 1px solid #ced4da;
    border-radius: 5px;
    padding: 8px 10px;
    background-color: #ffffff;
    color: #212529;
    font-size: 13px;
    font-weight: normal;
}

/* Efecto focus simulando Bootstrap (borde azul) */
QLineEdit:focus, QDateEdit:focus {
    border: 1px solid #86b7fe;
}

/* Campo deshabilitado / Solo lectura (txt_usuario) */
QLineEdit:read-only {
    background-color: #e9ecef;
    color: #6c757d;
}

/* Ajustes específicos para QDateEdit (la flecha del calendario) */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #ced4da;
    border-left-style: solid;
}

/* --- ALERTA DE INFORMACIÓN --- */
QLabel#lbl_alerta_info {
    background-color: #cff4fc;
    color: #055160;
    border: 1px solid #b6effb;
    border-radius: 6px;
    padding: 12px;
    font-weight: normal;
    font-size: 13px;
}

/* --- BOTONES --- */
QPushButton {
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 13px;
}

/* Botón Guardar (Azul primario) */
QPushButton#btn_guardar {
    background-color: #0d6efd;
    color: white;
    border: 1px solid #0d6efd;
}

QPushButton#btn_guardar:hover {
    background-color: #0b5ed7;
    border: 1px solid #0a58ca;
}

/* Botón Volver (Blanco/Gris claro estilo btn-light) */
QPushButton#btn_volver {
    background-color: #f8f9fa;
    color: #212529;
    border: 1px solid #d3d9df;
    font-weight: normal;
}

QPushButton#btn_volver:hover {
    background-color: #e2e6ea;
    border: 1px solid #dae0e5;
}</string>
