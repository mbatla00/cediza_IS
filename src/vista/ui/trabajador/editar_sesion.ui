  <property name="styleSheet">
   <string notr="true">/* --- FONDO DE LA VENTANA --- */
QMainWindow {
    background-color: #f8f9fa; 
}

/* --- EL CONTENEDOR (La Tarjeta Blanca) --- */
QFrame, QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
}

/* Limpieza de bordes heredados */
QLabel, QLineEdit, QDateEdit, QTimeEdit, QPlainTextEdit, QPushButton {
    border: none;
}

/* --- LA CABECERA AZUL --- */
QLabel#label {
    background-color: #0d6efd; /* Azul primario */
    color: white; /* Texto blanco para contrastar */
    font-size: 18px;
    font-weight: bold;
    padding: 12px 15px;
    border-top-left-radius: 8px; 
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

/* --- ETIQUETAS DE TEXTO (Labels) --- */
QLabel {
    color: #212529;
    font-weight: bold;
    font-size: 13px;
}

/* --- CAMPOS DE TEXTO, FECHA, HORA Y COMENTARIOS --- */
QLineEdit, QDateEdit, QTimeEdit, QPlainTextEdit {
    border: 1px solid #ced4da;
    border-radius: 5px;
    padding: 8px 10px;
    background-color: #ffffff;
    color: #212529;
    font-size: 13px;
    font-weight: normal;
}

/* Efecto focus simulando Bootstrap (borde azul claro) */
QLineEdit:focus, QDateEdit:focus, QTimeEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #86b7fe;
}

/* Campo deshabilitado / Solo lectura (txt_paciente) */
QLineEdit:read-only {
    background-color: #e9ecef;
    color: #6c757d;
}

/* Ajustes específicos para QDateEdit y QTimeEdit (la flechita de selección) */
QDateEdit::drop-down, QTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #ced4da;
    border-left-style: solid;
}

/* --- BOTONES --- */
QPushButton {
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 13px;
}

/* Botón Guardar (Tema Azul) */
QPushButton#btn_guardar {
    background-color: #0d6efd;
    color: white;
    border: 1px solid #0d6efd;
}

QPushButton#btn_guardar:hover {
    background-color: #0b5ed7;
    border: 1px solid #0a58ca;
}

/* Botón Cancelar (Tema Gris - Estilo btn-secondary) */
QPushButton#btn_cancelar {
    background-color: #6c757d;
    color: white;
    border: 1px solid #6c757d;
    font-weight: bold;
}

QPushButton#btn_cancelar:hover {
    background-color: #5c636a;
    border: 1px solid #565e64;
}</string>
