  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #f4f6f8;
}

/* El bloque azul superior sube a 17px */
QLabel#lbl_paciente {
    background-color: #0d6efd;
    color: white;
    font-size: 17px; 
    font-weight: bold;
    padding: 12px;
    border-radius: 6px;
}

/* Los títulos de las preguntas (Estado Emocional, Movilidad, Apetito) suben a 14px */
QGroupBox {
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-top: 20px;
    font-weight: bold;
    font-size: 14px; 
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #2c3e50;
    top: 5px;
}

/* Los botones circulares con las opciones suben a 13px */
QRadioButton {
    padding: 5px;
    font-weight: normal;
    font-size: 13px; 
}

/* El cuadro de texto para escribir las observaciones sube a 13px */
QPlainTextEdit {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 8px;
    background-color: #ffffff;
    selection-background-color: #0d6efd;
    font-size: 13px;
}

QPlainTextEdit:focus {
    border: 1px solid #0d6efd;
}

/* El texto de aviso &quot;Los campos marcados con * son obligatorios&quot; sube a 13px */
QLabel#lbl_aviso {
    color: #6c757d;
    font-style: italic;
    padding: 5px;
    font-size: 13px; 
}

/* Los botones de &quot;Cancelar / Volver&quot; y &quot;Guardar Evaluación&quot; suben a 14px */
QPushButton {
    background-color: #0d6efd;
    color: white;
    border-radius: 4px;
    padding: 8px;
    font-weight: bold;
    font-size: 14px; 
}

QPushButton:hover {
    background-color: #0b5ed7;
}

QPushButton#btn_volver {
    background-color: #6c757d; 
}

QPushButton#btn_volver:hover {
    background-color: #5a6268;
}</string>
