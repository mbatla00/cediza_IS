  <property name="styleSheet">
   <string notr="true">/* ================================================
   VENTANA PRINCIPAL Y FONDO
   ================================================ */
QMainWindow {
    background-color: #f8f9fa; /* Gris claro de fondo (Estilo Bootstrap bg-light) */
}

/* ================================================
   TITULOS, ENCABEZADOS Y LABELS
   ================================================ */
QLabel#lbl_titulo, QLabel#titulo {
    color: #212529;
    font-size: 22px; 
    font-weight: bold;
}

QLabel#lbl_subtitulo, QLabel#subtitulo {
    color: #6c757d;
    font-size: 14px;
    margin-bottom: 5px;
}

/* Textos informativos dentro de las tarjetas (ej: &quot;Seleccionar paciente:&quot;) */
QLabel {
    color: #495057;
    font-size: 13px;
}

/* ================================================
   TARJETAS DE ACCIÓN RAPIDA (QGroupBox)
   ================================================ */
QGroupBox {
    background-color: #ffffff; /* Fondo blanco puro */
    border: 1px solid #e3e6f0; /* Borde suave */
    border-radius: 8px;        /* Esquinas redondeadas de tarjeta web */
    margin-top: 24px;
    font-weight: bold;
    font-size: 14px; 
    color: #0d6efd;            /* Título de la tarjeta en azul Bootstrap */
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    top: 5px;
}

/* ================================================
   DESPLEGABLES (QComboBox)
   ================================================ */
QComboBox {
    border: 1px solid #ced4da;
    border-radius: 5px;
    padding: 6px 12px;
    background-color: #ffffff;
    color: #212529;
    font-size: 13px;
    min-height: 24px;
}

QComboBox:focus {
    border: 1px solid #86b7fe; /* Brillo azul focus al hacer clic */
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left-width: 0px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

/* Menú interno desplegado */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    selection-background-color: #0d6efd;
    selection-color: #ffffff;
}

/* ================================================
   BOTONES EN GENERAL (QPushButton)
   ================================================ */
QPushButton {
    background-color: #0d6efd; /* Azul corporativo por defecto */
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #0b5ed7; /* Azul más oscuro al pasar el ratón */
}

QPushButton:pressed {
    background-color: #0a58ca; /* Al hacer clic */
}

/* Botón Ver Perfil (Verde Bootstrap success) */
QPushButton#btn_perfil {
    background-color: #198754;
}

QPushButton#btn_perfil:hover {
    background-color: #157347;
}

QPushButton#btn_perfil:pressed {
    background-color: #146c43;
}

/* Botón Volver / Cancelar (Gris Bootstrap secondary) */
QPushButton#btn_volver, QPushButton#btn_cancelar {
    background-color: #6c757d; 
}

QPushButton#btn_volver:hover, QPushButton#btn_cancelar:hover {
    background-color: #5c636a;
}

QPushButton#btn_volver:pressed, QPushButton#btn_cancelar:pressed {
    background-color: #565e64;
}

/* ================================================
   BLOQUE DE LA TABLA (Fusión de Cabecera + Tabla)
   ================================================ */

/* Cabecera azul simulada con el QLabel superior */
QLabel#lbl_cabecera_tabla {
    background-color: #0d6efd; /* Azul de cabecera de tarjeta */
    color: white;
    font-size: 14px;
    font-weight: bold;
    padding: 12px 16px;
    border-top-left-radius: 8px;  /* Redondeamos solo arriba */
    border-top-right-radius: 8px;
    margin-bottom: 0px;           /* Completamente pegado a la tabla */
}

/* La cuadrícula de la tabla */
QTableWidget#tabla_pacientes, QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e3e6f0;
    border-top: none;                /* Quitamos borde de arriba para unirlo al azul */
    border-bottom-left-radius: 8px;  /* Redondeamos esquinas inferiores */
    border-bottom-right-radius: 8px;
    gridline-color: #f1f3f9;         /* Líneas de cuadrícula muy sutiles */
    font-size: 13px;
}

/* Títulos de las columnas (Nombre, Régimen, Acciones) */
QHeaderView::section {
    background-color: #f8f9fa;
    color: #495057;
    padding: 10px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-bottom: 2px solid #dee2e6; /* Línea de separación limpia */
}

/* Celdas de datos */
QTableWidget::item {
    padding: 12px;
    color: #212529;
    border-bottom: 1px solid #f1f3f9;
}

/* Fila cuando haces clic en ella */
QTableWidget::item:selected {
    background-color: #e8f0fe;
    color: #1a73e8;
}</string>
