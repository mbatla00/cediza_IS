  <property name="styleSheet">
   <string notr="true">/* =========================================
   1. FONDO GENERAL Y CONTENEDOR
========================================= */
QMainWindow, QWidget#centralwidget {
    background-color: #f4f6f8;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QWidget#scrollAreaWidgetContents {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #dee2e6;
}

/* Títulos generales */
QLabel#titulo {
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #084298;
    font-size: 24px;
    font-weight: bold;
    background: transparent;
}

QLabel#subtitulo {
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #6c757d;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

/* =========================================
   2. TEXTO DE LAS PREGUNTAS (lbl_p1, p2, p3, p4)
========================================= */
QLabel#lbl_p1, 
QLabel#lbl_p2, 
QLabel#lbl_p3, 
QLabel#lbl_p4 {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 15px;
    font-weight: bold;
    color: #2c3e50;
    background: transparent;
    margin-top: 15px;
    margin-bottom: 6px;
}

/* =========================================
   3. CAJAS DE TEXTO (QPlainTextEdit)
========================================= */
QPlainTextEdit {
    font-family: 'Segoe UI', Arial, sans-serif;
    background-color: #ffffff;
    border: 2px solid #ced4da;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
    color: #212529;
}

QPlainTextEdit:focus {
    border: 2px solid #86b7fe;
    background-color: #f8fbff;
}

/* =========================================
   4. DESPLEGABLES (QComboBox - FORZADO A BLANCO)
========================================= */
QComboBox {
    background-color: #ffffff;
    border: 2px solid #ced4da;
    border-radius: 6px;
    padding: 8px;
    color: #212529;
    font-size: 14px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Lista desplegada (donde estaba el color oscuro) */
QComboBox QAbstractItemView {
    background-color: #ffffff; /* Fondo blanco */
    color: #212529;           /* Texto negro */
    selection-background-color: #0d6efd; /* Azul al seleccionar */
    selection-color: #ffffff;
    border: 1px solid #ced4da;
    outline: none;
}

/* =========================================
   5. BOTONES DE RADIO (QRadioButton)
========================================= */
QRadioButton {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
    color: #495057;
    spacing: 8px;
    background: transparent;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 9px;
    border: 2px solid #ced4da;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    border-color: #0b5ed7;
    background-color: #0d6efd;
}

/* =========================================
   6. BOTONES DE ACCIÓN (Enviar/Cancelar)
========================================= */
QPushButton {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-weight: bold;
    font-size: 14px;
    border-radius: 6px;
    padding: 10px 22px;
}

QPushButton#btn_enviar {
    background-color: #0d6efd;
    color: white;
    border: none;
}
QPushButton#btn_enviar:hover {
    background-color: #0b5ed7;
}

QPushButton#btn_cancelar {
    background-color: transparent;
    color: #6c757d;
    border: 2px solid #6c757d;
}
QPushButton#btn_cancelar:hover {
    background-color: #6c757d;
    color: white;
}</string>
