  <property name="styleSheet">
   <string notr="true">/* =========================================
   1. FONDO GENERAL
========================================= */
QMainWindow, QWidget#centralwidget {
    background-color: #f4f6f8;
}

/* =========================================
   2. TÍTULO PRINCIPAL
========================================= */
QLabel#lbl_titulo_principal {
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #084298;
    font-size: 26px;
    font-weight: bold;
    background-color: transparent;
    border: none;
    padding: 0px;
    margin-bottom: 8px;
}

/* =========================================
   3. TARJETAS (QFrame externo)
========================================= */
QFrame#card_proximas, QFrame#card_pasadas {
    background-color: #ffffff;
    border: 2px solid #dee2e6;
    border-radius: 8px;
    padding: 0px;
}

/* =========================================
   4. CABECERAS DE LAS TARJETAS
========================================= */
QFrame#header_proximas {
    background-color: #0d6efd;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    border: none;
    padding: 0px;
    min-height: 45px;
}

QFrame#header_pasadas {
    background-color: #6c757d;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    border: none;
    padding: 0px;
    min-height: 45px;
}

/* =========================================
   5. LABELS DE CABECERA
========================================= */
QLabel#lbl_proximas, QLabel#lbl_pasadas {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    background-color: transparent;
    border: none;
    padding: 10px 15px;
}

/* =========================================
   6. TABLAS
========================================= */
QTableWidget {
    background-color: #f8faff;
    border: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    gridline-color: #dce3f0;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
    color: #212529;
    alternate-background-color: #eef2fb;
}

QHeaderView {
    background-color: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

QHeaderView::section {
    background-color: #e2e8f8;
    color: #2c3e6b;
    padding: 10px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-bottom: 2px solid #b0bfdf;
    min-height: 35px;
}

QTableWidget::item {
    padding: 10px;
    border-bottom: 1px solid #dce3f0;
    color: #212529;
}

QTableWidget::item:selected {
    background-color: #c8d8f8;
    color: #084298;
}

/* =========================================
   7. BOTÓN VOLVER
========================================= */
QPushButton#btn_volver {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-weight: bold;
    font-size: 13px;
    border-radius: 6px;
    padding: 8px 18px;
    background-color: #6c757d;
    color: #ffffff;
    border: none;
}

QPushButton#btn_volver:hover {
    background-color: #5a6268;
}</string>
