  <property name="styleSheet">
   <string notr="true">/* =========================================
   1. FONDO GENERAL DE LA VENTANA
========================================= */
QMainWindow, QWidget#centralwidget {
    background-color: #f4f6f8;
}

/* =========================================
   2. TÍTULOS PRINCIPALES (Encabezado superior)
========================================= */
QLabel#label {
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #084298 !important; 
    font-size: 28px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#label_2 {
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #344767 !important;
    font-size: 14px;
    font-weight: bold;
    background-color: transparent;
    margin-bottom: 8px;
}

/* =========================================
   3. ESTILO DE LAS TARJETAS (QFrame)
========================================= */
QFrame {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 15px;
}

QFrame#frame_emergencia {
    padding: 0px;
    border-radius: 4px;
}

QFrame#frame_emergencia QTableWidget {
    margin: 0px;
    padding: 0px;
    border-radius: 4px;
}

/* =========================================
   4. LABELS (Cajas Azules y Letras Blancas)
========================================= */
QLabel {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 12px;
    font-weight: bold;
    color: #ffffff;
    background-color: #084298;
    border-radius: 4px;
    padding: 4px 8px;
    margin-bottom: 2px;
}

QLabel[objectName^=&quot;lbl_titulo_&quot;] { 
    color: #495057;
    background-color: transparent;
    font-size: 16px;
    font-weight: bold;
    padding: 0px;
    padding-bottom: 6px;
    border-bottom: 1px solid #e9ecef;
}

/* =========================================
   5. CAMPOS DE TEXTO (QLineEdit)
========================================= */
QLineEdit {
    font-family: 'Segoe UI', Arial, sans-serif;
    background-color: #e9ecef;
    border: 1px solid #adb5bd;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    color: #495057;
}

QLineEdit:focus {
    border: 1px solid #86b7fe; 
    background-color: #ffffff; 
}

/* =========================================
   6. TABLA DE CONTACTOS DE EMERGENCIA
========================================= */
QTableWidget {
    background-color: #f8f9fa; 
    border: 1px solid #adb5bd; 
    border-radius: 4px;
    gridline-color: #ced4da;   
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
    color: #495057;
    min-height: 180px;
}

QHeaderView {
    background-color: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

QHeaderView::section {
    background-color: #e9ecef; 
    color: #495057;
    padding: 8px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-bottom: 2px solid #adb5bd;
    min-height: 35px;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #dee2e6;
    color: #495057;
    background-color: transparent;
}

QTableWidget::item:selected {
    background-color: #e8f0fe;
    color: #084298;
}

/* =========================================
   7. MENSAJE DE AVISO
========================================= */
QLabel#lbl_aviso_modificar {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #055160;             
    background-color: #cff4fc;
    border: 1px solid #b6effb;  
    border-radius: 6px;
    padding: 10px 15px;
}

/* =========================================
   8. BOTÓN VOLVER
========================================= */
QPushButton#btn_volver {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-weight: bold;
    font-size: 13px;
    border-radius: 6px;
    padding: 8px 18px;
    background-color: #6c757d;
    color: #ffffff;
    border: none;
}

QPushButton#btn_volver:hover {
    background-color: #5a6268;
}</string>
