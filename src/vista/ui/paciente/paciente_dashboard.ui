  <property name="styleSheet">
   <string notr="true">/* =========================================
   1. FONDO Y TEXTOS GENERALES
========================================= */
QMainWindow, QWidget#centralwidget {
    background-color: #f4f6f8;
}

QLabel {
    color: #2c3e50;
    background: transparent;
}

/* =========================================
   2. TÍTULOS PRINCIPALES (Bienvenida en Azul Oscuro)
========================================= */
QLabel#label_2 {
    color: #084298; /* Azul oscuro intenso */
    font-size: 26px;
    font-weight: bold; /* NEGRITA */
}

QLabel#label_3 {
    color: #084298; /* Azul oscuro intenso */
    font-size: 15px;
    font-weight: bold; /* NEGRITA */
    margin-bottom: 10px;
}

/* =========================================
   3. LAS 4 TARJETAS (QGroupBox)
========================================= */
QGroupBox#box_ejercicio, 
QGroupBox#box_historial, 
QGroupBox#box_datos, 
QGroupBox#box_sesiones {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding-top: 40px; 
}

/* =========================================
   4. CABECERAS DE LAS TARJETAS (AZUL OSCURO)
========================================= */
QGroupBox::title {
    background-color: #084298; /* Azul oscuro intenso */
    color: #ffffff;            
    font-size: 15px;
    font-weight: bold;         /* NEGRITA */
    padding: 10px 12px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    
    subcontrol-origin: margin;
    subcontrol-position: top center;
    width: 2000px; 
}

/* Títulos internos de las tarjetas */
QLabel#label, 
QLabel#label_5, 
QLabel#label_4, 
QLabel#label_6 {
    font-size: 16px;
    font-weight: bold;         /* NEGRITA */
    margin-top: 10px;
    color: #2c3e50;
}

/* Textos descriptivos pequeños dentro de la tarjeta */
QLabel#label_7, 
QLabel#label_8, 
QLabel#label_10, 
QLabel#label_9 {
    color: #6c757d;
    font-size: 13px;
    font-weight: bold;         /* NEGRITA */
}

/* =========================================
   5. BOTONES DE LAS TARJETAS (AZULES)
========================================= */
QPushButton {
    font-weight: bold;         /* NEGRITA PARA TODOS LOS BOTONES */
    font-size: 14px;
    border-radius: 6px;
    padding: 10px 15px;
}

/* Los 4 botones centrales en azul normal */
QPushButton#btn_cuestionario_diario, 
QPushButton#btn_ver_historial, 
QPushButton#btn_informacion_personal, 
QPushButton#btn_sesiones {
    background-color: #0d6efd; 
    color: white;
    border: none;
}

QPushButton#btn_cuestionario_diario:hover, 
QPushButton#btn_ver_historial:hover, 
QPushButton#btn_informacion_personal:hover, 
QPushButton#btn_sesiones:hover { 
    background-color: #0b5ed7; 
}

/* =========================================
   6. BOTÓN INFERIOR (Volver / Gris)
========================================= */
QPushButton#btn_volver {
    background-color: #6c757d; /* GRIS BOOTSTRAP */
    color: white;
    border: none;
    padding: 8px 20px;
    font-weight: bold;         /* NEGRITA */
}

QPushButton#btn_volver:hover { 
    background-color: #5a6268; 
}</string>
