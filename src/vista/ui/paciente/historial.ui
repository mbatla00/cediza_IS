  <property name="styleSheet">
   <string notr="true">/* Fondo general de la ventana principal */
QMainWindow {
    background-color: #f4f6f8;
}

/* Tarjeta contenedora blanca */
#card_frame {
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
}

/* Cabecera de la tarjeta con el azul clásico */
#header_frame {
    background-color: #0d6efd;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

/* Texto del título dentro del cuadro azul */
#lbl_titulo {
    color: white;
    font-size: 16px;
    font-weight: bold;
}

/* Subtítulo del cuerpo en gris apagado */
#lbl_subtitulo {
    color: #6c757d;
    font-size: 13px;
}

/* Limpieza del área de scroll (sin bordes feos) */
QScrollArea {
    border: none;
    background-color: transparent;
}

#scrollAreaWidgetContents {
    background-color: transparent;
}

/* Botón Volver (Estilo gris idéntico al de tu ejemplo) */
QPushButton#btn_volver {
    background-color: #6c757d;
    color: white;
    border-radius: 4px;
    padding: 8px;
    font-weight: bold;
    font-size: 14px;
}

/* Efecto Hover para el botón Volver */
QPushButton#btn_volver:hover {
    background-color: #5a6268;
}</string>
