  <property name="styleSheet">
   <string notr="true">/* =========================================
   1. FONDO DE LA VENTANA (Gris clarito web)
========================================= */
QMainWindow, QWidget#centralwidget {
    background-color: #f4f6f8;
}

/* Ocultar los bordes del ScrollArea y hacerlo transparente */
QScrollArea {
    border: none;
    background-color: transparent;
}
QWidget#scrollAreaWidgetContents {
    background-color: transparent;
}

/* TÍTULO PRINCIPAL DE LA VENTANA (Editar Usuario) */
QLabel#label_7 {
    color: #2c3e50;
    font-size: 24px;       
    font-weight: bold;     
    padding-bottom: 5px;
    background-color: transparent;
}

/* ETIQUETAS DE LOS CAMPOS (Nombre, Teléfono, etc.) */
QLabel {
    color: #2c3e50;
    font-size: 14px;       
    font-weight: bold;     /* Texto de los campos en negrita limpia */
    background-color: transparent;
}

/* =========================================
   2. EL EFECTO &quot;TARJETA BLANCA&quot; (QGroupBox)
========================================= */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    margin-top: 25px; /* Deja espacio para que el título respire */
    padding-top: 35px;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
}

/* TÍTULO NORMAL DE LOS BLOQUES (Sin recuadro azul) */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;
    top: 5px;
    padding: 0 5px;
    color: #0d6efd; /* Tu azul principal para las letras */
    font-size: 16px;
    font-weight: bold;
    background-color: #ffffff; /* Fondo blanco para cortar la línea del borde */
}

/* =========================================
   3. CAJAS DE TEXTO, FECHAS Y DESPLEGABLES
========================================= */
QLineEdit, QDateEdit, QComboBox {
    border: 1px solid #adb5bd;
    border-radius: 6px;
    padding: 8px 10px;
    background-color: #f8f9fa;
    font-size: 13px;
    color: #2c3e50;
    min-height: 22px;
    selection-background-color: #0d6efd; 
    selection-color: #ffffff;            
}

/* Efecto Focus al hacer click o escribir */
QLineEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 2px solid #0d6efd;
    background-color: #ffffff;
}

/* Campo deshabilitado / Solo lectura (Nombre de Usuario) */
QLineEdit:read-only {
    background-color: #e9ecef;
    color: #6c757d;
    border: 1px solid #ced4da;
}

/* Solución al desplegable oscuro del ComboBox */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #dee2e6;
    selection-background-color: #0d6efd; 
    selection-color: #ffffff;
}

/* =========================================
   4. 🌟 SOLUCIÓN AL FONDO OSCURO EN TABLAS Y LISTAS 🌟
========================================= */
QListWidget, QTableWidget, QListView, QTableView {
    background-color: #ffffff !important;
    alternate-background-color: #ffffff !important; 
    border: 1px solid #dee2e6;
    border-radius: 6px;
    font-size: 13px;
    color: #2c3e50;
    min-height: 140px; 
}

/* Esta regla quita el fondo gris oscuro de la zona vacía de la tabla/lista */
QAbstractScrollArea::viewport, 
QListWidget::viewport, 
QTableWidget::viewport {
    background-color: #ffffff !important;
}

/* Forzar que las celdas internas de la tabla tengan fondo blanco puro */
QTableWidget::item {
    background-color: #ffffff !important;
    color: #2c3e50;
}

/* Cabeceras de la tabla (Nombre, Parentesco, Teléfono) */
QHeaderView::section {
    background-color: #ffffff !important; 
    color: #2c3e50;
    font-size: 13px;       
    font-weight: bold;     
    padding: 8px;
    border: none;
    border-bottom: 2px solid #dee2e6; 
    border-right: 1px solid #e9ecef;
}

QTableCornerButton::section {
    background-color: #ffffff !important;
    border: none;
    border-bottom: 2px solid #dee2e6;
}

/* =========================================
   5. BOTONES DE ACCIÓN PRINCIPALES (Abajo)
========================================= */
QPushButton#btn_guardar {
    background-color: #0d6efd;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_guardar:hover { background-color: #0b5ed7; }

QPushButton#btn_cancelar {
    background-color: #6c757d;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_cancelar:hover { background-color: #5a6268; }

/* 🌟 NUEVO: Botón para dar de Baja / Activar Usuario 🌟 */
QPushButton#btn_baja {
    background-color: #f39c12; /* Color naranja/ámbar de advertencia */
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_baja:hover { 
    background-color: #d68910; /* Un tono más oscuro al pasar el ratón */
}

/* =========================================
   6. BOTONES SECUNDARIOS (+ Añadir)
========================================= */
QPushButton#btn_anadir_contacto, 
QPushButton#btn_anadir_enfermedad {
    background-color: #e9ecef;
    color: #0d6efd;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btn_anadir_contacto:hover, 
QPushButton#btn_anadir_enfermedad:hover {
    background-color: #dee2e6;
}</string>
