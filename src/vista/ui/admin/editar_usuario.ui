  <property name="styleSheet">
   <string notr="true">/* 1. Fondo de la ventana (Gris clarito) */
QWidget#centralwidget {
    background-color: #f4f6f8;
}

/* 2. Ocultar los bordes feos del ScrollArea para que parezca web */
QScrollArea {
    border: none;
    background-color: transparent;
}
QWidget#scrollAreaWidgetContents {
    background-color: transparent;
}

/* 3. El efecto &quot;Tarjeta Blanca&quot; para los bloques de datos */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    margin-top: 25px; /* Deja espacio para que el título respire */
    padding: 20px;
}

/* 4. Título de los bloques (Ej: &quot;Datos Comunes&quot;) */
QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 5px;
    color: #0d6efd; /* Azul principal */
    font-size: 16px;
    font-weight: bold;
}

/* 5. Cajas de texto, fechas y desplegables */
QLineEdit, QDateEdit, QComboBox {
    border: 1px solid #adb5bd;
    border-radius: 6px;
    padding: 10px;
    background-color: #f8f9fa;
    font-size: 14px;
    color: #2c3e50;
    min-height: 20px;
}

/* Efecto al escribir o seleccionar */
QLineEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 2px solid #0d6efd;
    background-color: #ffffff;
}

/* 6. Botones Fijos de abajo */
QPushButton#btn_guardar {
    background-color: #0d6efd;
    color: white;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_guardar:hover { background-color: #0b5ed7; }

QPushButton#btn_cancelar {
    background-color: #6c757d;
    color: white;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_cancelar:hover { background-color: #5a6268; }

/* 7. Botones pequeñitos de añadir (+) en el paciente */
QPushButton#btn_anadir_contacto, QPushButton#btn_anadir_enfermedad {
    background-color: #e9ecef;
    color: #0d6efd;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 8px;
    font-weight: bold;
}
QPushButton#btn_anadir_contacto:hover, QPushButton#btn_anadir_enfermedad:hover {
    background-color: #dee2e6;
}</string>
