  <property name="styleSheet">
   <string notr="true">/* Fondo de la ventana emergente */
QDialog {
    background-color: #ffffff;
}

/* Títulos y textos */
QLabel {
    color: #2c3e50;
    font-size: 14px;
    font-weight: bold;
    margin-top: 5px;
}

/* Textos informativos (ej. &quot;El nuevo administrador tendrá...&quot;) */
QLabel#label_8 {
    color: #6c757d;
    font-weight: normal;
    font-size: 12px;
}

/* Cajas de texto (Inputs) */
QLineEdit {
    border: 1px solid #adb5bd;
    border-radius: 6px;
    padding: 10px;
    background-color: #f8f9fa;
    font-size: 14px;
    color: #2c3e50;
    min-width: 200px;
}

/* Efecto al hacer clic en las cajas */
QLineEdit:focus {
    border: 2px solid #0d6efd;
    background-color: #ffffff;
}

/* Botón principal (Crear Admin) */
QPushButton#btn_crear {
    background-color: #0d6efd;
    color: white;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#btn_crear:hover {
    background-color: #0b5ed7;
}

/* Botón secundario (Cancelar) */
QPushButton#btn_cancelar {
    background-color: #6c757d;
    color: white;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#btn_cancelar:hover {
    background-color: #5a6268;
}</string>
