  <property name="styleSheet">
   <string notr="true">/* Fondo general de la ventana */
QMainWindow, QWidget#centralwidget {
    background-color: #f4f6f8;
}

/* Tarjeta blanca central */
QFrame#card_perfil {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 30px;
}

/* Título principal de bienvenida */
QLabel#lbl_titulo {
    color: #2c3e50;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 15px;
}

/* Etiquetas de los campos (Nombre, DNI, etc.) */
QLabel {
    font-size: 14px;
    font-weight: bold;
    color: #2c3e50;
    margin-top: 5px;
}

/* Aviso de que el usuario no se cambia */
QLabel#lbl_aviso_usuario {
    font-size: 12px;
    color: #dc3545; /* Rojo suave para indicar restricción */
    font-weight: normal;
    font-style: italic;
}

/* Cajas de texto y selector de fecha con más contraste */
QLineEdit, QDateEdit {
    border: 1px solid #adb5bd; /* Borde ligeramente más oscuro y definido */
    border-radius: 6px;
    padding: 10px;
    background-color: #f8f9fa; /* Gris casi blanco para que resalten sobre la tarjeta */
    font-size: 14px;
    color: #2c3e50;
    min-width: 250px;
}

/* Efecto azul fuerte al escribir (se mantiene) */
QLineEdit:focus, QDateEdit:focus {
    border: 2px solid #0d6efd;
    background-color: #ffffff; /* Al hacer clic, se vuelven blancas para dar efecto de &quot;iluminado&quot; */
}

/* Quitar las flechitas feas del QDateEdit si lo prefieres más limpio */
QDateEdit::drop-down {
    border: none;
    padding-right: 10px;
}

/* Botones principales */
QPushButton {
    background-color: #0d6efd;
    color: white;
    border-radius: 6px;
    padding: 12px 20px;
    font-weight: bold;
    font-size: 14px;
    margin-top: 15px;
}

QPushButton:hover {
    background-color: #0b5ed7;
}

/* Botón de volver (Gris) */
QPushButton#btn_volver {
    background-color: #6c757d;
}

QPushButton#btn_volver:hover {
    background-color: #5a6268;
}</string>
