  <property name="styleSheet">
   <string notr="true">/* 1. Fondo de la ventana (Gris clarito web) */
QDialog {
    background-color: #f4f6f8;
}

/* 2. El efecto &quot;Tarjeta Blanca&quot; para el QGroupBox */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    margin-top: 25px;
    padding: 20px;
}

/* 3. Título de la tarjeta (&quot;Registro de Trabajador&quot;) */
QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 5px;
    color: #0d6efd; /* Azul principal */
    font-size: 16px;
    font-weight: bold;
}

/* 4. Cajas de texto y combos básicos */
QLineEdit, QComboBox {
    border: 1px solid #adb5bd;
    border-radius: 6px;
    padding: 8px 12px;
    background-color: #f8f9fa;
    font-size: 14px;
    color: #2c3e50;
}
QLineEdit:focus, QComboBox:focus {
    border: 2px solid #0d6efd;
    background-color: #ffffff;
}

/* 🌟 SOLUCIÓN AL DESPLEGABLE OSCURO 🌟 */
/* Fuerza a que la lista flotante interna sea blanca y el texto oscuro */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    background: #ffffff;
    color: #2c3e50;
    border: 1px solid #dee2e6;
    selection-background-color: #0d6efd; /* Color azul al pasar el ratón */
    selection-color: #ffffff;
}

/* 5. Botón principal: Guardar / Confirmar (Azul) */
QPushButton#btn_guardar {
    background-color: #0d6efd;
    color: white;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_guardar:hover { background-color: #0b5ed7; }

/* 6. Botón secundario: Cancelar (Gris) */
QPushButton#btn_cancelar {
    background-color: #6c757d;
    color: white;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_cancelar:hover { background-color: #5a6268; }</string>
