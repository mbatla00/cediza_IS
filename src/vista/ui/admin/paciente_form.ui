  <property name="styleSheet">
   <string notr="true">/* =========================================
   1. FONDO GENERAL Y SCROLL (OPCIÓN NUCLEAR)
========================================= */
QDialog, QScrollArea {
    background-color: #ffffff; 
    border: none;
}

/* Esto fuerza a que cualquier widget dentro del scroll sea blanco puro */
QScrollArea &gt; QWidget &gt; QWidget, 
QWidget#scrollAreaWidgetContents {
    background-color: #ffffff;
}

QLabel {
    color: #334155; 
    font-size: 13px;
    font-weight: 500; 
    background-color: transparent; /* Evita que las letras tengan parches grises */
}

/* =========================================
   2. TARJETAS BLANCAS (QGroupBox)
========================================= */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1; /* Borde gris sutil */
    border-radius: 8px;
    margin-top: 10px; 
    padding-top: 40px; /* Espacio interno superior para que quepa el título */
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
}

QGroupBox::title {
    subcontrol-origin: padding; /* Mete el texto dentro del borde para que no se corte */
    subcontrol-position: top left;
    left: 20px;
    top: 12px;
    color: #0f172a; 
    font-size: 15px;
    font-weight: bold;
    background-color: transparent; 
}

/* =========================================
   3. CAMPOS DE ENTRADA (Estilo Premium)
========================================= */
QLineEdit, QDateEdit, QComboBox {
    border: 1px solid #cbd5e1; 
    border-radius: 6px;
    padding: 6px 12px;
    background-color: #ffffff;
    font-size: 13px;
    color: #1e293b;
    min-height: 25px; /* EVITA QUE EL TEXTO SE CORTE VERTICALMENTE */
}

QLineEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 1px solid #3b82f6; 
    background-color: #ffffff;
}

QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    background: transparent;
    width: 20px;
}

/* =========================================
   4. TABLAS Y LISTAS (TODO BLANCO PURO)
========================================= */
QListWidget, QTableWidget, QListView, QTableView {
    background-color: #ffffff !important;
    alternate-background-color: #ffffff !important; /* Evita que las filas pares se pongan grises */
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 13px;
    color: #334155;
    min-height: 120px; 
}

/* El hueco vacío donde no hay datos todavía */
QAbstractScrollArea::viewport, 
QListWidget::viewport, 
QTableWidget::viewport {
    background-color: #ffffff !important;
}

/* Las celdas individuales (para que no hereden grises del sistema) */
QTableWidget::item {
    background-color: #ffffff !important;
}

/* LAS CABECERAS (Donde pone Nombre, Parentesco, Teléfono) */
QHeaderView::section {
    background-color: #ffffff !important; /* BLANCO PURO */
    color: #0f172a;
    font-weight: bold;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #cbd5e1; /* Línea abajo para separar títulos de datos */
    border-right: 1px solid #e2e8f0;
}

/* El cuadradito de la esquina superior izquierda de la tabla */
QTableCornerButton::section {
    background-color: #ffffff !important;
    border: none;
    border-bottom: 2px solid #cbd5e1;
}

/* =========================================
   5. BOTONES DE ACCIÓN PRINCIPALES (Abajo)
========================================= */
QPushButton#btn_guardar {
    background-color: #0d6efd;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_guardar:hover {
    background-color: #0b5ed7;
}
QPushButton#btn_guardar:pressed {
    background-color: #0a58ca;
}

QPushButton#btn_cancelar {
    background-color: #64748b;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_cancelar:hover {
    background-color: #475569;
}
QPushButton#btn_cancelar:pressed {
    background-color: #334155;
}

/* =========================================
   6. BOTONES SECUNDARIOS (+ Añadir) EN AZUL
========================================= */
QPushButton#btn_anadir_contacto, 
QPushButton#btn_anadir_enfermedad {
    background-color: #0d6efd; 
    color: #ffffff;            
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#btn_anadir_contacto:hover, 
QPushButton#btn_anadir_enfermedad:hover {
    background-color: #0b5ed7; 
}

QPushButton#btn_anadir_contacto:pressed, 
QPushButton#btn_anadir_enfermedad:pressed {
    background-color: #0a58ca;
}</string>
