  <property name="styleSheet">
   <string notr="true">/* 1. Fondo de la ventana (Gris clarito web) */
QDialog {
    background-color: #f4f6f8;
}

/* NUEVO: Color oscuro para todas las etiquetas de texto del formulario (Nombre, DNI, etc.) */
QLabel {
    color: #2c3e50;
}

/* 2. El efecto &quot;Tarjeta Blanca&quot; para los QGroupBox */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    margin-top: 25px; /* Deja espacio para que el título respire */
    padding: 20px;
}

/* 3. Títulos de las tarjetas (Ej: &quot;Datos Personales&quot;) */
QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 5px;
    color: #0d6efd; /* Azul principal */
    font-size: 16px;
    font-weight: bold;
}

/* 4. Cajas de texto, fechas y combos (Estilo Bootstrap) */
QLineEdit, QDateEdit, QComboBox {
    border: 1px solid #adb5bd;
    border-radius: 6px;
    padding: 8px 12px;
    background-color: #f8f9fa;
    font-size: 14px;
    color: #2c3e50;
    selection-background-color: #0d6efd;
    selection-color: #ffffff;
}
QLineEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 2px solid #0d6efd;
    background-color: #ffffff;
}

/* 5. Botones Fijos de abajo */
QPushButton#btn_guardar {
    background-color: #0d6efd;
    color: white;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_guardar:hover { background-color: #0b5ed7; }

QPushButton#btn_cancelar {
    background-color: #6c757d;
    color: white;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btn_cancelar:hover { background-color: #5a6268; }

/* 6. Botones secundarios de añadir (+) */
QPushButton#btn_anadir_contacto, QPushButton#btn_anadir_enfermedad {
    background-color: #e9ecef;
    color: #0d6efd;
    border: 1px solid #ced4da;
    border-radius: 6px;
    padding: 8px 15px;
    font-weight: bold;
}
QPushButton#btn_anadir_contacto:hover, QPushButton#btn_anadir_enfermedad:hover {
    background-color: #dee2e6;
}</string>
