  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #f4f6f8;
}

QWidget#centralwidget {
    background-color: #f4f6f8;
}

/* La tarjeta blanca central con bordes redondeados y sombra suave */
QFrame#loginCard {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 20px;
}

/* Logotipo / Título principal */
QLabel#Titulo {
    color: #0d6efd;
    font-size: 26px;
    font-weight: bold;
    margin-bottom: 15px;
    background-color: transparent;
}

/* Etiquetas de los campos (Usuario y Contraseña) */
QLabel#textoUsuario, QLabel#textoContrasena {
    color: #2c3e50;
    font-size: 13px;
    font-weight: bold;
    margin-top: 8px;
    background-color: transparent;
}

/* Cajas de texto para rellenar */
QLineEdit {
    border: 1px solid #ced4da;
    border-radius: 6px;
    padding: 10px;
    background-color: #ffffff;
    font-size: 14px;
    color: #2c3e50;
}

/* Efecto azul cuando el usuario hace clic para escribir */
QLineEdit:focus {
    border: 2px solid #0d6efd;
}

/* Botón azul moderno de Iniciar Sesión */
QPushButton#btn_login {
    background-color: #0d6efd;
    color: white;
    border-radius: 6px;
    padding: 12px;
    font-weight: bold;
    font-size: 14px;
    margin-top: 15px;
}

QPushButton#btn_login:hover {
    background-color: #0b5ed7;
}

QPushButton#btn_login:pressed {
    background-color: #0a58ca;
}</string>
